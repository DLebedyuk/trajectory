# Настройки production-стенда. Скопируйте в .env.production рядом с
# docker-compose.prod.yml и заполните. Файл с настоящими значениями в
# репозиторий не попадает — он в .gitignore.
#
# Проверить заполненное, ничего не печатая:  ./infrastructure/check-prod-config.sh

# --- домен ---
# A-запись должна указывать на этот сервер: по ней Caddy получает сертификат.
DOMAIN=planner.example.com
# Сюда Let's Encrypt напишет, если сертификат перестанет обновляться.
ACME_EMAIL=you@example.com

# --- база ---
# Пароль придумайте длинный и случайный:  openssl rand -hex 24
# Именно hex, не base64: пароль подставляется в строку подключения
# postgres://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@postgres:5432/БАЗА, а символы / + = её ломают.
POSTGRES_USER=planner
POSTGRES_PASSWORD=
POSTGRES_DB=planner

# --- сессии и шифрование ---
# openssl rand -base64 48
SESSION_SECRET=
SESSION_TTL_DAYS=30
# Ровно 32 байта: openssl rand -hex 32
# Этим ключом шифруются refresh-токены Google в базе. Потеряете — придётся
# заново подключать календарь; смените на другой — старые токены не расшифруются.
TOKEN_ENCRYPTION_KEY=

# --- вход через Google ---
# В Google Cloud Console → Credentials → OAuth 2.0 Client ID (тип Web).
# В «Authorized redirect URIs» добавьте ОБА адреса:
#   https://ВАШ_ДОМЕН/api/auth/google/callback
#   https://ВАШ_ДОМЕН/api/calendar/google/callback
# Для календаря отдельно включите Google Calendar API в том же проекте.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Telegram ---
# off — бот выключен. webhook — единственный режим для production: адрес
# формируется автоматически как https://ВАШ_ДОМЕН/api/telegram/webhook.
TELEGRAM_MODE=off
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Только латиница, цифры, дефис и подчёркивание: openssl rand -hex 16
# Без него ручку вебхука может дёрнуть кто угодно.
TELEGRAM_WEBHOOK_SECRET=

# --- разбор входящих ИИ ---
# mock — разбор правилами, без внешних запросов и без денег.
# openai — живой платный endpoint, нужен AI_API_KEY.
AI_PROVIDER=mock
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=20000

# --- прочее ---
APP_TIMEZONE=Europe/Moscow
# Миграции применяются при каждом старте контейнера api.
RUN_MIGRATIONS=true

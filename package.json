{
  "name": "personal-planner",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @planner/api --filter @planner/web dev",
    "dev:api": "pnpm --filter @planner/api dev",
    "dev:web": "pnpm --filter @planner/web dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --filter './packages/*' build && pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @planner/api db:generate",
    "db:migrate": "pnpm --filter @planner/api db:migrate",
    "db:seed": "pnpm --filter @planner/api db:seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.9.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.12.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vitest": "^2.1.5"
  }
}

# --- база ---
DATABASE_URL=postgres://planner:planner@localhost:5432/planner

# --- api ---
PORT=3000
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173

# --- telegram ---
# Пусто => бот не стартует, доставка напоминаний идёт в mock-канал console
TELEGRAM_BOT_TOKEN=
# polling | webhook | off
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_URL=

# --- вход через Google (production) ---
# Что создать в Google Cloud Console — см. раздел «Авторизация» в README.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_AUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/calendar/google/callback
# Куда вернуть браузер после входа
APP_BASE_URL=http://localhost:5173
# Длинная случайная строка. В production обязателен.
SESSION_SECRET=
SESSION_TTL_DAYS=30
# 32 байта в hex — шифрование refresh-токенов календаря в БД
TOKEN_ENCRYPTION_KEY=

# --- ИИ ---
# mock — детерминированные правила без сети; openai — реальный провайдер.
# Ключ живёт только здесь, на сервере. В репозиторий не коммитить.
AI_PROVIDER=mock
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=20000

# --- development-пользователь ---
# ВНИМАНИЕ: dev-режим авторизации. В production обязателен реальный auth.
DEV_USER_ID=00000000-0000-4000-8000-000000000001
DEV_AUTH=true

APP_TIMEZONE=Europe/Moscow

# --- web (Vite) ---
VITE_API_URL=http://localhost:3000
# DEVELOPMENT-ONLY. Если задать, фронтенд шлёт x-user-id и ходит в API от имени
# этого пользователя. Сервер принимает заголовок только при DEV_AUTH=true.
# Пусто => сервер сам подставит DEV_USER_ID.
VITE_DEV_USER_ID=

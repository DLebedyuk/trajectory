# Шаблон настроек. Скопируйте его в .env и заполняйте ТОЛЬКО .env —
# этот файл лежит в git, а .env в .gitignore и никуда не уедет.
#
#   cp .env.example .env      (Windows PowerShell: Copy-Item .env.example .env)
#
# docker compose читает .env из этой же папки, поэтому одного файла хватает
# и для `pnpm dev`, и для docker-стенда.

# --- база ---
DATABASE_URL=postgres://planner:planner@localhost:5432/planner

# --- api ---
PORT=3000
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173

# --- telegram ---
# Пусто => бот не стартует, доставка напоминаний идёт в mock-канал console
TELEGRAM_BOT_TOKEN=
# polling | webhook | off
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_URL=
# Имя бота без @ — из него строится ссылка «открыть бота с кодом»
TELEGRAM_BOT_USERNAME=
# Секрет вебхука: только латиница, цифры, дефис и подчёркивание.
# Обязателен при TELEGRAM_MODE=webhook — без него ручку может дёрнуть кто угодно.
TELEGRAM_WEBHOOK_SECRET=

# --- вход через Google (production) ---
# Что создать в Google Cloud Console — см. раздел «Авторизация» в README.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Эти три значения — для локального запуска через pnpm dev.
# В docker-стенде всё отдаётся на :8080, и там они перекрыты в docker-compose.yml.
GOOGLE_AUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/calendar/google/callback
APP_BASE_URL=http://localhost:5173
# Длинная случайная строка. В production обязателен.
SESSION_SECRET=
SESSION_TTL_DAYS=30
# 32 байта в hex — шифрование refresh-токенов календаря в БД.
# openssl rand -hex 32
# PowerShell: -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Max 256) })
# Без него подключение календаря будет отклонено с понятным сообщением.
TOKEN_ENCRYPTION_KEY=

# --- ИИ ---
# mock — детерминированные правила без сети; openai — реальный провайдер.
# Ключ живёт только здесь, на сервере. В репозиторий не коммитить.
# mock — детерминированные правила без сети и без трат;
# openai — реальный разбор. Без AI_API_KEY остаётся mock в любом случае.
AI_PROVIDER=mock
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=20000

# --- development-пользователь ---
# ВНИМАНИЕ: dev-режим авторизации. В production обязателен реальный auth.
DEV_USER_ID=00000000-0000-4000-8000-000000000001
# true — вход не нужен, все запросы от DEV_USER_ID (демо-данные видны).
# false — работает настоящий вход через Google.
DEV_AUTH=true

APP_TIMEZONE=Europe/Moscow

# --- web (Vite) ---
VITE_API_URL=http://localhost:3000
# DEVELOPMENT-ONLY. Если задать, фронтенд шлёт x-user-id и ходит в API от имени
# этого пользователя. Сервер принимает заголовок только при # true — вход не нужен, все запросы от DEV_USER_ID (демо-данные видны).
# false — работает настоящий вход через Google.
DEV_AUTH=true.
# Пусто => сервер сам подставит DEV_USER_ID.
VITE_DEV_USER_ID=
